{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codju-content",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ADMIN_EMAIL": "bhavishyasingla2005@gmail.com",
    "DESIGNER_EMAIL": "gurpreetcodju@gmail.com",
    "SENDER_EMAIL": "Bhavishya <noreply@hibhavishya.in>"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codju-content-db",
      "database_id": "9d2fba12-d01f-4260-867f-c384937fad63"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "codju-content-assets"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "triggers": {
    "crons": [
      "30 6 * * *"
    ]
  }
}
